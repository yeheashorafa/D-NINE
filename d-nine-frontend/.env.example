# Server-only source switch: 'static' (default fallback) or 'sanity'
CONTENT_SOURCE=static

# Public Sanity project config (safe for browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=xg3zrwt3
NEXT_PUBLIC_SANITY_DATASET=development
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-22
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Server-only Sanity read/viewer token for draft mode & live content (minimum read permissions)
SANITY_API_READ_TOKEN=

# Server-only webhook secret for cache tag revalidation
SANITY_REVALIDATE_SECRET=

# Public API URL for transactional Express backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
