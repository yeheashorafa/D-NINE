generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubmissionStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  SPAM
}

enum BookingStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  COMPLETED
  CANCELLED
  SPAM
}

enum SubscriptionStatus {
  ACTIVE
  UNSUBSCRIBED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model ContactSubmission {
  id          String           @id @default(cuid())
  fullName    String
  email       String
  phone       String?
  serviceSlug String
  message     String
  locale      String           @default("ar")
  sourcePage  String?
  status      SubmissionStatus @default(NEW)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([serviceSlug])
  @@map("contact_submissions")
}

model BookCallRequest {
  id            String        @id @default(cuid())
  fullName      String
  email         String
  phone         String?
  companyName   String?
  serviceSlug   String
  preferredDate String
  preferredTime String
  timezone      String
  notes         String?
  locale        String        @default("ar")
  sourcePage    String?
  status        BookingStatus @default(PENDING_CONFIRMATION)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("book_call_requests")
}

model NewsletterSubscription {
  id         String             @id @default(cuid())
  email      String             @unique
  locale     String             @default("ar")
  sourcePage String?
  status     SubscriptionStatus @default(ACTIVE)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("newsletter_subscriptions")
}

model EmailDelivery {
  id          String              @id @default(cuid())
  to          String
  subject     String
  status      EmailDeliveryStatus @default(PENDING)
  referenceId String? // ID of the related submission/booking
  error       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([referenceId])
  @@map("email_deliveries")
}
