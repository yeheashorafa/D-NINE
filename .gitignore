# ==========================================
# D-NINE Monorepo
# ==========================================

# Dependencies — all workspaces
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/
.npm/

# Environment variables and secrets
.env
.env.*
**/.env
**/.env.*

# Keep environment templates
!.env.example
!**/.env.example

# Next.js frontend
.next/
out/
.vercel/

# Express backend
dist/
build/
logs/
*.log
uploads/

# Sanity Studio
.sanity/
.sanity-cache/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing
coverage/
test-results/
playwright-report/

# Local databases
*.sqlite
*.sqlite3
*.db
*.db-journal

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE and operating system
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Temporary files
*.tmp
*.temp
*.swp
*.swo
.cache/
tmp/
temp/

# Certificates and private keys
*.pem
*.key
*.p12
*.pfx

# Archives
*.zip
*.rar
*.7z
*.tar
*.tar.gz