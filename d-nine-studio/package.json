{
  "name": "d-nine-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build dist",
    "deploy": "sanity deploy",
    "schema:extract": "sanity schema extract --enforce-required-fields",
    "typegen": "sanity typegen generate",
    "documents:validate": "sanity documents validate",
    "typecheck": "tsc --noEmit",
    "content:services:dry": "tsx scripts/migrate-service-taxonomy.ts --dry-run",
    "content:services": "tsx scripts/migrate-service-taxonomy.ts --execute",
    "content:portfolio:dry": "tsx scripts/migrate-portfolio-categories.ts --dry-run",
    "content:portfolio": "tsx scripts/migrate-portfolio-categories.ts --execute",
    "content:remove-team:dry": "tsx scripts/remove-team-content.ts --dry-run",
    "content:remove-team": "tsx scripts/remove-team-content.ts --execute",
    "content:remove-unverified-testimonials:dry": "tsx scripts/remove-unverified-testimonials.ts --dry-run",
    "content:remove-unverified-testimonials": "tsx scripts/remove-unverified-testimonials.ts --execute",
    "content:remove-legacy-services:dry": "tsx scripts/remove-legacy-services.ts --dry-run",
    "content:remove-legacy-services": "tsx scripts/remove-legacy-services.ts --execute",
    "test:migration": "tsx scripts/test-migration-utils.ts"
  },
  "dependencies": {
    "@d-nine/sanity-config": "*",
    "@sanity/icons": "3.7.0",
    "@sanity/vision": "6.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.0.0",
    "sanity": "6.19.0",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
